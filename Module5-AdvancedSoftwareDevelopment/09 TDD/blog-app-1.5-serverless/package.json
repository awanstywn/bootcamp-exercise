{
  "name": "blog-app",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run prisma:generate && concurrently -c \"cyan,magenta\" -n \"client,server\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "concurrently -c \"cyan,magenta\" -n \"client,server\" \"npm run preview --workspace=client\" \"npm run start --workspace=server\"",
    "start:docker": "concurrently -c \"cyan,magenta\" -n \"client,server\" \"npm run preview --workspace=client\" \"npm run start:docker --workspace=server\"",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server",
    "prisma:studio": "npm run prisma:studio --workspace=server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  }
}

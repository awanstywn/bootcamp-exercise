generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────

enum Category {
  MEN
  WOMEN
  UNISEX
}

enum ScentFamily {
  FLORAL
  WOODY
  FRESH
  ORIENTAL
  CITRUS
  AQUATIC
  GOURMAND
  AROMATIC
}

enum Concentration {
  EDT
  EDP
  PARFUM
  EDC
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELED
}

enum ShippingMethod {
  REGULAR
  EXPRESS
}

// ─── Models ─────────────────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  name             String   @db.VarChar(100)
  email            String   @unique @db.VarChar(255)
  passwordHash     String   @db.Text
  role             UserRole @default(CUSTOMER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders           Order[]
  addresses        UserAddress[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model UserAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @db.VarChar(100)
  address    String   @db.Text
  city       String   @db.VarChar(100)
  province   String   @db.VarChar(100)
  postalCode String   @db.VarChar(10)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("user_addresses")
}

model Product {
  id            String        @id @default(uuid())
  name          String        @db.VarChar(150)
  brand         String        @db.VarChar(100)
  slug          String        @unique @db.VarChar(200)
  category      Category
  scentFamily   ScentFamily
  notesTop      String        @db.Text
  notesHeart    String        @db.Text
  notesBase     String        @db.Text
  concentration Concentration
  price         Decimal       @db.Decimal(10, 2)
  volumeMl      Int
  stock         Int           @default(0)
  status        ProductStatus @default(ACTIVE)
  imageUrl      String        @db.Text
  description   String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  images        ProductImage[]
  orderItems    OrderItem[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String   @db.Text
  altText   String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique @db.VarChar(50)

  // Customer info (supports guest checkout)
  customerName    String         @db.VarChar(150)
  customerEmail   String         @db.VarChar(255)
  customerPhone   String         @db.VarChar(30)

  // Shipping address
  address         String         @db.Text
  city            String         @db.VarChar(100)
  province        String         @db.VarChar(100)
  postalCode      String         @db.VarChar(10)
  note            String?        @db.Text

  // Order details
  shippingMethod  ShippingMethod @default(REGULAR)
  shippingCost    Decimal        @db.Decimal(10, 2) @default(0)
  subtotal        Decimal        @db.Decimal(12, 2)
  total           Decimal        @db.Decimal(12, 2)
  status          OrderStatus    @default(PENDING_PAYMENT)
  paymentProofUrl String?        @db.Text
  paidAt          DateTime?

  // Relations
  userId          String?
  user            User?          @relation(fields: [userId], references: [id])
  items           OrderItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String  @db.VarChar(150)
  brand       String  @db.VarChar(100)
  imageUrl    String  @db.Text
  price       Decimal @db.Decimal(10, 2)
  volumeMl    Int
  quantity    Int

  @@map("order_items")
}

model SiteSettings {
  id              String   @id @default("singleton")
  bankName        String   @default("") @db.VarChar(100)
  bankAccountName String   @default("") @db.VarChar(100)
  bankAccountNo   String   @default("") @db.VarChar(50)
  whatsappNumber  String   @default("") @db.VarChar(30)
  updatedAt       DateTime @updatedAt

  @@map("site_settings")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model ContentPage {
  id        String   @id @default(uuid())
  slug      String   @unique @db.VarChar(100)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_pages")
}

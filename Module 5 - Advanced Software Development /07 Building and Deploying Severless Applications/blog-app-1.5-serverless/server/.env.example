# ==========================================
# Core Application Settings
# ==========================================
NODE_ENV="development"
PORT=3000
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:3000"

# ==========================================
# Database Configuration
# ==========================================
# Replace placeholders with your actual PostgreSQL credentials
DATABASE_URL="postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DATABASE_NAME>?schema=public"
DIRECT_URL=""

# ==========================================
# Authentication & Security
# ==========================================
# Generate a random 32+ character string (e.g., using `openssl rand -base64 32`)
JWT_ACCESS_SECRET="<YOUR_ACCESS_SECRET_KEY>"
JWT_REFRESH_SECRET="<YOUR_REFRESH_SECRET_KEY>"

# ==========================================
# Cloudinary (Image Uploads)
# Dashboard: https://cloudinary.com/console
# ==========================================
CLOUDINARY_CLOUD_NAME="<YOUR_CLOUD_NAME>"
CLOUDINARY_API_KEY="<YOUR_API_KEY>"
CLOUDINARY_API_SECRET="<YOUR_API_SECRET>"

# ==========================================
# SMTP (Email Service via Nodemailer)
# Use App Passwords for Gmail: https://myaccount.google.com/apppasswords
# ==========================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="<YOUR_EMAIL@gmail.com>"
SMTP_PASS="<YOUR_APP_PASSWORD>"

# ==========================================
# Google OAuth (Social Login)
# Console: https://console.cloud.google.com/apis/credentials
# ==========================================
GOOGLE_CLIENT_ID="<YOUR_GOOGLE_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<YOUR_GOOGLE_CLIENT_SECRET>"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# ==========================================
# Redis & Caching
# ==========================================
REDIS_URL="redis://localhost:6379"
CACHE_TTL=300
